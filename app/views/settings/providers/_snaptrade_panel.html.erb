<div id="snaptrade-providers-panel" class="space-y-4">
  <%= render DS::Alert.new(message: t("providers.snaptrade.free_tier_warning"), variant: :warning) %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <%
    items = local_assigns[:snaptrade_items] || @snaptrade_items || Current.family.snaptrade_items.active.ordered
    snaptrade_item = items.reject(&:scheduled_for_deletion?).first
    oauth_env_configured = Provider::Snaptrade.oauth_configured?
    redirect_flow_available = Provider::Snaptrade.authorization_code_configured?
    oauth_active = snaptrade_item&.oauth_token_active?
    oauth_item_id = snaptrade_item&.persisted? ? snaptrade_item.id : nil
  %>

  <% if !oauth_env_configured %>
    <%# Without an OAuth app, a SnapTrade Personal API key (the family's own %>
    <%# clientId + consumerKey) is how this instance reads SnapTrade data. %>
    <%= render layout: "settings/providers/snaptrade_credential_card",
               locals: {
                 title: t("providers.snaptrade.personal_key_title"),
                 description: t("providers.snaptrade.personal_key_description_html").html_safe
               } do %>
      <%= styled_form_with url: personal_key_snaptrade_items_path,
                           scope: :snaptrade_item,
                           method: :post,
                           data: { turbo: true },
                           class: "space-y-3" do |form| %>
        <%= form.text_field :client_id,
                            label: t("providers.snaptrade.personal_key_client_id_label"),
                            autocomplete: "off",
                            value: nil %>

        <%= form.text_field :consumer_key,
                            label: t("providers.snaptrade.personal_key_consumer_key_label"),
                            type: :password,
                            autocomplete: "off",
                            value: nil %>

        <%= form.submit t("providers.snaptrade.personal_key_save_button") %>
      <% end %>
    <% end %>

    <p class="text-sm text-secondary"><%= t("providers.snaptrade.oauth_alternative") %></p>
    <%= render "settings/providers/setup_steps",
               steps: [
                 t("providers.snaptrade.oauth_setup_step_1_html").html_safe,
                 t("providers.snaptrade.oauth_setup_step_2_html", callback_url: oauth_callback_snaptrade_items_url).html_safe,
                 t("providers.snaptrade.oauth_setup_step_3")
               ] %>
  <% else %>
    <%
      oauth_status = if oauth_active
        t("providers.snaptrade.oauth_status_authorized")
      elsif redirect_flow_available
        t("providers.snaptrade.oauth_status_ready")
      else
        t("providers.snaptrade.oauth_status_ready_device")
      end
    %>
    <%= render layout: "settings/providers/snaptrade_credential_card",
               locals: { title: t("providers.snaptrade.oauth_title"), description: oauth_status } do %>
      <%# Both grants end with the same access token; which ones are offered %>
      <%# depends only on what this deployment configured. %>
      <% if redirect_flow_available %>
        <%= render DS::Link.new(
          text: oauth_active ? t("providers.snaptrade.oauth_reauthorize_button") : t("providers.snaptrade.oauth_connect_button"),
          icon: "external-link",
          variant: :primary,
          full_width: true,
          href: oauth_authorize_snaptrade_items_path(item_id: oauth_item_id)
        ) %>

        <%= render DS::Link.new(
          text: t("providers.snaptrade.oauth_device_button"),
          icon: "keyboard",
          variant: :secondary,
          full_width: true,
          href: oauth_device_authorize_snaptrade_items_path(item_id: oauth_item_id),
          frame: :drawer
        ) %>
      <% else %>
        <%= render DS::Link.new(
          text: oauth_active ? t("providers.snaptrade.oauth_reauthorize_button") : t("providers.snaptrade.oauth_device_button"),
          icon: "keyboard",
          variant: :primary,
          full_width: true,
          href: oauth_device_authorize_snaptrade_items_path(item_id: oauth_item_id),
          frame: :drawer
        ) %>
      <% end %>
    <% end %>
  <% end %>

    <% if snaptrade_item&.persisted? && snaptrade_item.credentials_configured? %>
      <div class="border-t border-primary pt-4 mt-4">
        <%# "Manage Connections" in the item menu links here with ?manage=1. %>
        <%# The row's auto-open reads and drops it, so open from the server. %>
        <%= render DS::Disclosure.new(
          variant: :inline,
          open: params[:manage] == "1",
          data: {
            controller: "lazy-load",
            action: "toggle->lazy-load#toggled",
            lazy_load_url_value: connections_snaptrade_item_path(snaptrade_item)
          }
        ) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <p class="text-sm text-secondary">
                  <%= t("providers.snaptrade.status_connected", count: snaptrade_item.snaptrade_accounts.count) %>
                  <% if snaptrade_item.unlinked_accounts_count > 0 %>
                    <span class="text-warning">(<%= t("providers.snaptrade.needs_setup", count: snaptrade_item.unlinked_accounts_count) %>)</span>
                  <% end %>
                </p>
              </div>
              <span class="flex items-center gap-1 text-sm text-secondary hover:text-primary">
                <%= t("providers.snaptrade.manage_connections") %>
                <%= icon "chevron-right", class: "w-3 h-3 group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>
              </span>
            </div>
          <% end %>

          <div class="mt-3 space-y-3" data-lazy-load-target="content">
            <div data-lazy-load-target="loading" class="flex items-center gap-2 text-sm text-secondary py-2">
              <%= icon "loader-2", class: "w-4 h-4 animate-spin" %>
              <%= t("providers.snaptrade.loading_connections") %>
            </div>

            <div data-lazy-load-target="frame">
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
</div>
