<%# locals: (title:, description:) %>
<%# How this instance authorizes SnapTrade: heading, status line, then the action(s) passed as the block. %>
<div class="bg-surface-inset rounded-xl p-4 space-y-3">
  <div class="flex items-start gap-3">
    <span class="w-9 h-9 rounded-lg bg-success/10 flex items-center justify-center shrink-0">
      <%= icon "key-round", class: "w-4 h-4 text-success" %>
    </span>
    <div class="min-w-0">
      <p class="text-sm font-medium text-primary"><%= title %></p>
      <p class="text-sm text-secondary"><%= description %></p>
    </div>
  </div>

  <%= yield %>
</div>
